#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,matrix-transform = &default_transform;
        zephyr,display = &oled;
        zephyr,console = &cdc_acm_uart;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2)
            RC(1,0) RC(1,1) RC(1,2)
            RC(2,0) RC(2,1) RC(2,2)
            RC(3,0) RC(3,1)
        >;
    };

    kscan: kscan {
        compatible = "zmk,kscan-composite";
        rows = <4>;
        columns = <3>;

        // 1. Matice 3x3 na pinech 4-9
        matrix {
            kscan = <&kscan_matrix>;
        };

        // 2. Samostatný pin 10 posunutý na řádek 3 + enkodeŕ tlačítko
        direct {
            kscan = <&kscan_direct>;
            row-offset = <3>;
        };

        // 3. Tlačítko enkoderu
        encoder_btn {
            kscan = <&kscan_direct_enc>;
            row-offset = <3>;
            column-offset = <1>;
        };
    };

    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        col-gpios
            = <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>;

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };
    
    // S10
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        input-gpios = 
            <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    // SW Enkoder
    kscan_direct_enc: kscan_direct_enc {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

&pro_micro_i2c {
    status = "okay";
    
    // OLED displej na I2C adrese 0x3c (nejčastější adresa pro SSD1306)
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        
        // Parametry pro typický 0.91" OLED
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>; // 31 je pro 32px výšku
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

/ {
    // 1. Definice samotného hardwaru enkodéru
    encoder: encoder {
        compatible = "alps,ec11";
        
        // ZDE UPRAVTE PINY podle toho, kam jste zapojili vývody A a B z enkodéru.
        // V tomto příkladu jsou použity piny 21 a 20 na nice!nano.
        a-gpios = <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        
        // Rozlišení enkodéru (obvykle 4x počet fyzických "cvaknutí" na otáčku).
        // Bourns PEC11L má typicky 15 nebo 20 pulzů. Pokud má 20 pulzů -> 80 kroků.
        // Pokud enkodér dělá "dvojkliky" na jedno fyzické cvaknutí, zkuste změnit na 40.
        steps = <80>;
        status = "okay";
    };

    // 2. Zaregistrování enkodéru do ZMK subsystému jako senzoru
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        
        // Kolik akcí se má vyvolat na jednu celou otáčku (odpovídá fyzickým zarážkám)
        triggers-per-rotation = <20>;
    };
};